# Shape only. deploy/hetzner/install.sh writes the real .env and chmod 600.
# Do not copy these placeholder secrets onto a server.

DOMAIN=reply.example.com
ACME_EMAIL=hello@example.com
NEXTAUTH_URL=https://reply.example.com
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
CRON_SECRET=replace-with-openssl-rand-hex-32
CRON_BASE_URL=http://web:3000
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WEBHOOK_VERIFY_TOKEN=replace-with-openssl-rand-hex-32

POSTGRES_USER=openreply
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=openreply
DATABASE_URL=postgresql://openreply:replace-with-openssl-rand-hex-24@postgres:5432/openreply

REDIS_PASSWORD=replace-with-openssl-rand-hex-24
REDIS_URL=redis://:replace-with-openssl-rand-hex-24@redis:6379?family=0

META_GRAPH_API_VERSION=v25.0
RESEND_API_KEY=re_replace_me
EMAIL_FROM=OpenReply <hello@example.com>
ALLOWED_EMAILS=hello@example.com

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=
